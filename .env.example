# Required for summaries, title generation, extraction, and transcript chat.
MISTRAL_API_KEY=your_mistral_api_key_here

# Required only when Language is set to hinglish (Sarvam speech-to-text/translation).
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional local Whisper model name; defaults to small.
WHISPER_MODEL=small

# Optional Sarvam model; defaults to saaras:v2.5.
SARVAM_STT_MODEL=saaras:v2.5
